# AI-WORLD-WAR configuration. Copy to .env and fill in values.
# RESEARCH SIMULATION - not a forecasting or decision-support system.
# Never commit a real .env file.

# Server
PORT=8787
HOST=127.0.0.1
DB_PATH=./data/aiww.sqlite
LOG_LEVEL=info

# Provider mode: "openrouter" for real model calls, "mock" for offline
# deterministic development/tests. The server never silently substitutes
# mock for OpenRouter: provider failures are surfaced to the user.
DEFAULT_PROVIDER=mock

# OpenRouter (https://openrouter.ai/docs/quickstart)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_NATION_AGENT_MODEL=openai/gpt-4o-mini
OPENROUTER_WORLD_NARRATOR_MODEL=openai/gpt-4o-mini
OPENROUTER_REPAIR_MODEL=openai/gpt-4o-mini

# OpenRouter client behavior
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_RETRIES=3
OPENROUTER_RETRY_BASE_DELAY_MS=500
OPENROUTER_CATALOG_CACHE_TTL_MS=300000
OPENROUTER_RESPONSE_CACHE_TTL_MS=600000
